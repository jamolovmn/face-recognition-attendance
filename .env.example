# Copy to .env and fill in:  cp .env.example .env

# ---------------------------------------------------------------- Cameras
# Comma-separated camera ids. Each id needs a CAM_<ID>_* block below.
CAMERAS=room1,room2

# RTSP URL - find it with:  python -m attendance.probe <camera-ip> --user admin --password ...
# Use the MAIN stream (full resolution) - faces far away need the pixels.
CAM_ROOM1_RTSP=rtsp://admin:password@192.168.1.50:554/ch0_0.h264
CAM_ROOM1_ROOM=Office 1
# Optional low-resolution sub-stream (e.g. 640x360). Used only to watch for motion:
# much cheaper than decoding the main stream 24/7. Find it with probe (2nd profile).
CAM_ROOM1_RTSP_SUB=rtsp://admin:password@192.168.1.50:554/ch0_1.h264
CAM_ROOM1_PTZ=true
CAM_ROOM1_ONVIF_HOST=192.168.1.50
CAM_ROOM1_ONVIF_PORT=8899
CAM_ROOM1_ONVIF_USER=admin
CAM_ROOM1_ONVIF_PASS=password
# Preset token the camera returns to when idle (point it at the door). Empty = ONVIF home position.
CAM_ROOM1_HOME_PRESET=

CAM_ROOM2_RTSP=rtsp://admin:password@192.168.1.51:554/ch0_0.h264
CAM_ROOM2_ROOM=Office 2
CAM_ROOM2_RTSP_SUB=rtsp://admin:password@192.168.1.51:554/ch0_1.h264
CAM_ROOM2_PTZ=true
CAM_ROOM2_ONVIF_HOST=192.168.1.51
CAM_ROOM2_ONVIF_PORT=8899
CAM_ROOM2_ONVIF_USER=admin
CAM_ROOM2_ONVIF_PASS=password
CAM_ROOM2_HOME_PRESET=

# ------------------------------------------------------------ Recognition
# Frames analysed per second per camera (CPU budget). 2-3 is enough for a doorway.
PROCESS_FPS=3
# Frames are downscaled to this width for detection (recognition uses full resolution).
DETECT_WIDTH=1280
DETECT_SCORE=0.8
# Ignore faces smaller than this (pixels) - too small to recognise reliably.
MIN_FACE_PX=40
# SFace cosine similarity. OpenCV reference value is 0.363; higher = stricter.
MATCH_THRESHOLD=0.40
# Person must be matched this many times within CONFIRM_WINDOW_SEC before an event is written.
CONFIRM_HITS=3
CONFIRM_WINDOW_SEC=4
# Skip detection when nothing moves (saves a lot of CPU). While idle the main stream
# decodes keyframes only; on motion it switches to full decoding for ACTIVE_HOLD_SEC.
MOTION_GATE=true
MOTION_THRESHOLD=0.004
ACTIVE_HOLD_SEC=6
# Calm mode: when everyone in view is already identified and logged, analyse only
# CALM_FPS frames/s on keyframes with a cheaper detection width. A known face is
# re-checked every REVERIFY_SEC instead of on every frame.
CALM_FPS=1
CALM_DETECT_WIDTH=640
REVERIFY_SEC=5

# --------------------------------------------------------------- Schedule
# Working hours (local time, TZ below). Empty = 24/7. Ranges over midnight work too.
ACTIVE_HOURS=07:00-20:00
# ISO weekdays, 1 = Monday. Examples: 1-5, 1-6, 1,2,3,4,5
ACTIVE_DAYS=1-6
# Outside working hours: off = disconnect cameras (0% CPU), watch = keep working as usual
OFF_HOURS_MODE=off

# ----------------------------------------------------------------- Events
# Same person in the same room is logged at most once per COOLDOWN_MIN.
COOLDOWN_MIN=10
# Log strangers (with a snapshot).
UNKNOWN_EVENTS=true
UNKNOWN_COOLDOWN_MIN=5
SNAPSHOT=true

# -------------------------------------------------------------------- PTZ
# Fraction of the frame around the centre where the camera does not move.
PTZ_DEADZONE=0.12
PTZ_SPEED=0.5
# Zoom in until the face is this wide (pixels) - ~110+ gives the best recognition.
PTZ_ZOOM_TARGET_PX=120
# Return to the home position after this many seconds without faces.
PTZ_IDLE_RETURN_SEC=20

# -------------------------------------------------------------- Nextcloud
# Nextcloud user with an app password (Settings -> Security -> Devices & sessions).
# The user must be an admin or a member of the "attendance" group.
NC_URL=https://cloud.example.com
NC_USER=attendance-bot
NC_APP_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx
NC_VERIFY_TLS=true

# --------------------------------------------------------------- Failover
# Run the service on two always-on PCs: only one connects to the cameras.
# If the active one stops sending heartbeats for LEASE_TTL_SEC, the other takes
# over; when the preferred one (lowest NODE_PRIORITY) comes back it takes over again.
FAILOVER=false
# NODE_ID=office-pc-1        # default: computer name
NODE_PRIORITY=1              # 1 = main PC, 2 = backup PC
LEASE_TTL_SEC=45

# ------------------------------------------------------------------ Other
TZ=Asia/Tashkent
LOG_LEVEL=INFO
# LOG_FILE=data/attendance.log   # also write a rotating log file (used on Windows)
